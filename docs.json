{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Maki",
  "description": "Maki (maki.finance) is the meme coin launchpad on Robinhood Chain. Launch a token in seconds, trade it on a fair bonding curve, and graduate to Uniswap v3 with liquidity locked forever.",
  "colors": {
    "primary": "#ED5B25",
    "light": "#FF8A50",
    "dark": "#C2410C"
  },
  "logo": {
    "light": "/logo/maki-mark.png",
    "dark": "/logo/maki-mark.png"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#FBF7EE",
      "dark": "#131118"
    }
  },
  "fonts": {
    "heading": {
      "family": "Pixelify Sans"
    },
    "body": {
      "family": "Inter"
    }
  },
  "navbar": {
    "links": [
      {
        "href": "https://discord.gg/makidotfinance",
        "label": "Support"
      },
      {
        "href": "https://maki.finance",
        "label": "Launch App"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://maki.finance",
      "x": "https://x.com/MakiDotFinance",
      "telegram": "https://t.me/MakiDotFinance",
      "discord": "https://discord.gg/makidotfinance"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "introduction/why",
              "introduction/how-it-works",
              "introduction/official-links",
              "introduction/faq"
            ]
          },
          {
            "group": "Getting Started",
            "pages": [
              "guides/connect-wallet",
              "guides/launch-a-token",
              "guides/trading",
              "guides/creator-rewards"
            ]
          },
          {
            "group": "Protocol",
            "pages": [
              "protocol/bonding-curve",
              "protocol/graduation",
              "protocol/fees",
              "protocol/security"
            ]
          },
          {
            "group": "Developers",
            "pages": [
              "developers/overview",
              "developers/sdk",
              "developers/contracts"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "legal/terms-of-service",
              "legal/privacy-policy",
              "legal/risk-disclosure"
            ]
          }
        ]
      }
    ]
  }
}
