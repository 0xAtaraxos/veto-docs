{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "veto.fun",
  "description": "veto.fun is the meme coin launchpad on Robinhood Chain. Launch a token in seconds, trade it on a fair bonding curve, and graduate to Uniswap v3 with liquidity locked forever.",
  "colors": {
    "primary": "#A7D106",
    "light": "#CCFF07",
    "dark": "#A7D106"
  },
  "logo": {
    "light": "/logo/veto-wordmark-black.svg",
    "dark": "/logo/veto-wordmark-white.svg"
  },
  "favicon": {
    "light": "/logo/veto-black.svg",
    "dark": "/logo/veto-white.svg"
  },
  "appearance": {
    "default": "dark"
  },
  "navbar": {
    "links": [
      {
        "href": "https://discord.gg/vetodotfun",
        "label": "Support"
      },
      {
        "href": "https://veto.fun",
        "label": "Launch App"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://veto.fun",
      "x": "https://x.com/VetoDotFun",
      "telegram": "https://t.me/vetodotfun",
      "discord": "https://discord.gg/vetodotfun"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "index",
              "introduction/how-it-works",
              "introduction/veto-token",
              "introduction/official-links",
              "introduction/faq"
            ]
          },
          {
            "group": "Getting Started",
            "pages": [
              "guides/connect-wallet",
              "guides/launch-a-token",
              "guides/trading",
              "guides/creator-rewards"
            ]
          },
          {
            "group": "Protocol",
            "pages": [
              "protocol/bonding-curve",
              "protocol/graduation",
              "protocol/fees",
              "protocol/security"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "legal/terms-of-service",
              "legal/privacy-policy",
              "legal/risk-disclosure"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "icon": "code",
        "groups": [
          {
            "group": "Developers",
            "pages": [
              "developers/overview",
              "developers/sdk",
              "developers/contracts"
            ]
          }
        ]
      }
    ]
  }
}
